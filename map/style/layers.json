[
  {
    "id": "spotlight",
    "type": "fill",
    "source": "spotlight",
    "paint": { "fill-color": "#121620", "fill-opacity": 0.42 }
  },
  {
    "id": "clusters",
    "type": "circle",
    "source": "deployments",
    "filter": ["has", "point_count"],
    "paint": {
      "circle-color": "#39424e",
      "circle-opacity": 0.85,
      "circle-radius": ["step", ["get", "point_count"], 14, 25, 20, 100, 26],
      "circle-stroke-width": 2,
      "circle-stroke-color": "#fff"
    }
  },
  {
    "id": "cluster-count",
    "type": "symbol",
    "source": "deployments",
    "filter": ["has", "point_count"],
    "layout": {
      "text-field": ["get", "point_count_abbreviated"],
      "text-size": 13,
      "text-font": ["Noto Sans Regular"]
    },
    "paint": { "text-color": "#ffffff" }
  },
  {
    "id": "points",
    "type": "symbol",
    "source": "deployments",
    "filter": ["!", ["has", "point_count"]],
    "layout": {
      "icon-image": ["concat", "marker-", ["get", "op"]],
      "icon-size": 0.5,
      "icon-allow-overlap": true,
      "symbol-sort-key": ["-", 0, ["get", "ts"]],
      "text-field": [
        "case",
        [">", ["coalesce", ["get", "stackN"], 0], 1],
        ["concat", "^", ["to-string", ["get", "stackN"]]],
        ""
      ],
      "text-font": ["Noto Sans Regular"],
      "text-size": 11,
      "text-offset": [0.9, -0.9],
      "text-allow-overlap": true,
      "text-ignore-placement": true
    },
    "paint": {
      "text-color": "#1c2430",
      "text-halo-color": "#ffffff",
      "text-halo-width": 1.6
    }
  }
]
